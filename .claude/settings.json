{
  "advisorModel": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cat >/dev/null 2>&1; printf %s '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"Reminder (CLAUDE.md Model Assignment Rules, advisory): delegate to a subagent when context-isolation pays off — implementation (Sonnet) for multi-file features/refactors, architecture-review (Opus) for design decisions. For small in-context edits (a typo, a link, a one-file rename), just edit directly; spawning a subagent costs more than it saves. This is guidance, not a gate. The security-review requirement is separately ENFORCED by the Stop hook, not by this reminder.\"}}'",
            "statusMessage": "Checking edit-delegation policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/security-gate/mark-review-owed.sh\"",
            "statusMessage": "security-gate: checking touched paths"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/security-gate/mark-review-owed-bash.sh\"",
            "statusMessage": "security-gate: checking pnpm add/remove"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/security-gate/clear-review-owed.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/security-gate/gate-stop.sh\"",
            "statusMessage": "security-gate: verifying review owed"
          }
        ]
      }
    ]
  }
}
